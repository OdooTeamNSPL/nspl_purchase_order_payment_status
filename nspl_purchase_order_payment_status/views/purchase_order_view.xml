<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_list_inherit_payment_status" model="ir.ui.view">
        <field name="name">purchase.order.list.inherit.payment.status</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="payment_status" readonly="1"
                           decoration-success="payment_status == 'paid'"
                           decoration-warning="payment_status == 'partial'"
                           decoration-danger="payment_status == 'not_paid'"/>
                <field name="amount_due" widget="monetary" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_inherit_payment_status" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.payment.status</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="payment_status" readonly="1" widget="badge"/>
                <field name="amount_due" readonly="1" widget="monetary"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_search_filter_payment_status" model="ir.ui.view">
        <field name="name">purchase.order.search.filter.payment.status</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='order_date']" position="after">
                <filter name="filter_fully_paid" string="Fully Paid"
                        domain="[('payment_status', '=', 'paid')]"/>
                <filter name="filter_partial_paid" string="Partially Paid"
                        domain="[('payment_status', '=', 'partial')]"/>
                <filter name="filter_not_paid" string="Not Paid"
                        domain="[('payment_status', '=', 'not_paid')]"/>
                <filter name="filter_overdue" string="Overdue"
                        domain="[('payment_status', '=', 'overdue')]"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_search_groupby_payment_status" model="ir.ui.view">
        <field name="name">purchase.order.search.groupby.payment.status</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@expand='0']" position="inside">
                <filter name="group_by_payment_status"
                        string="Payment Status"
                        context="{'group_by': 'payment_status'}"/>
            </xpath>
        </field>
    </record>

</odoo>
